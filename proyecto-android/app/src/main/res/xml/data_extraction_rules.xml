<?xml version="1.0" encoding="utf-8"?>
<!-- Auditoría H-12: Panoptes guarda resultados de análisis (endpoints, secretos candidatos,
     rutas de APK...). Nada de eso debe salir en copias de seguridad en la nube ni en
     transferencias entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
