<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_titulo"
            android:textSize="22sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_motor_transcripcion"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_motor_vosk"
            android:textSize="14sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_asistente_hyperos"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_asistente_hyperos_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boton_asistente_hyperos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_abrir_ajustes"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_debug_titulo"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_debug_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boton_ver_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_ver_log"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_acerca_de"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_acerca_de_texto"
            android:textSize="13sp"
            android:textColor="#B0B0D0" />

    </LinearLayout>
</ScrollView>