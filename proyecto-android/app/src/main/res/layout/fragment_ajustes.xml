<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_titulo"
            android:textSize="22sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="16dp" />

        <!-- Afinado diarización -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎛 Afinado de diarización"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Afecta a cómo se separan los hablantes. Se aplica en la próxima grabación."
            android:textSize="12sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de hablantes"
            android:textSize="13sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="8dp" />

        <RadioGroup
            android:id="@+id/grupo_hablantes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton android:id="@+id/radio_hablantes_auto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto" android:textColor="#F0EEF8" android:checked="true" />
            <RadioButton android:id="@+id/radio_hablantes_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#F0EEF8" />
            <RadioButton android:id="@+id/radio_hablantes_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#F0EEF8" />
            <RadioButton android:id="@+id/radio_hablantes_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#F0EEF8" />
            <RadioButton android:id="@+id/radio_hablantes_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#F0EEF8" />
            <RadioButton android:id="@+id/radio_hablantes_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#F0EEF8" />
            <RadioButton android:id="@+id/radio_hablantes_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textColor="#F0EEF8" />
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Umbral de clustering (0.30 – 0.90)" android:textSize="13sp" android:textColor="#F0EEF8" android:layout_marginTop="12dp" />
        <EditText android:id="@+id/input_umbral" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="0.55" android:textColor="#F0EEF8" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Duración mínima de fragmento (ms)" android:textSize="13sp" android:textColor="#F0EEF8" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/input_min_frag" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="2000" android:textColor="#F0EEF8" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gap de fusión de turnos (ms)" android:textSize="13sp" android:textColor="#F0EEF8" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/input_gap" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="500" android:textColor="#F0EEF8" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hop de ventana (ms)" android:textSize="13sp" android:textColor="#F0EEF8" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/input_hop" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="5000" android:textColor="#F0EEF8" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/boton_guardar_ajustes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💾 Guardar" />
            <Button android:id="@+id/boton_resetear_ajustes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="↺ Restablecer" />
        </LinearLayout>

        <!-- Whisper -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 Motor Whisper (alta calidad)"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Whisper transcribe el WAV completo al final, ofreciendo mucha mejor precisión que Vosk. Requiere descargar el modelo la primera vez."
            android:textSize="12sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/texto_estado_whisper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comprobando…"
            android:textSize="13sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boton_descargar_whisper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📥 Descargar modelo (~809 MB)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boton_borrar_whisper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑 Borrar modelo Whisper"
            android:layout_marginBottom="16dp" />

        <!-- Almacenamiento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💾 Almacenamiento"
            android:textSize="16sp"
            android:textColor="#F0EEF8"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/texto_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando…"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boton_limpiar_wavs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑 Limpiar todos los WAVs"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boton_borrar_todo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑 Borrar todas las conversaciones"
            android:layout_marginBottom="16dp" />
<Button
    android:id="@+id/boton_descargar_whisper"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="📥 Descargar modelo (~620 MB)"
    android:layout_marginBottom="8dp" />

<Button
    android:id="@+id/boton_seleccionar_modelo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="📂 Seleccionar archivo .gguf"
    android:layout_marginBottom="8dp" />

<Button
    android:id="@+id/boton_borrar_whisper"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="🗑 Borrar modelo Whisper"
    android:layout_marginBottom="16dp" />

        <!-- HyperOS -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_asistente_hyperos" android:textSize="16sp" android:textColor="#F0EEF8" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_asistente_hyperos_desc" android:textSize="13sp" android:textColor="#B0B0D0" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/boton_asistente_hyperos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/config_boton_abrir_ajustes" android:layout_marginBottom="24dp" />

        <!-- Debug -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_debug_titulo" android:textSize="16sp" android:textColor="#F0EEF8" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_debug_desc" android:textSize="13sp" android:textColor="#B0B0D0" android:layout_marginBottom="8dp" />
        <Button android:id="@+id/boton_ver_log" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_ver_log" android:layout_marginBottom="24dp" />

        <!-- Acerca de -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_acerca_de" android:textSize="16sp" android:textColor="#F0EEF8" android:layout_marginTop="16dp" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ajustes_acerca_de_texto" android:textSize="13sp" android:textColor="#B0B0D0" />

    </LinearLayout>
</ScrollView>