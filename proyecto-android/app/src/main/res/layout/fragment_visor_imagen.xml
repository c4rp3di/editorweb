<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.carpe.gestorarchivos.ui.ZoomImageView
        android:id="@+id/imagenZoom"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/cargandoImagen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="@color/visor_barra">

        <ImageView
            android:id="@+id/botonVolverImg"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@android:color/white"
            android:contentDescription="Cerrar" />

        <TextView
            android:id="@+id/nombreImg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:maxLines="1"
            android:ellipsize="middle"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />

        <ImageView
            android:id="@+id/botonExternoImg"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_view"
            android:tint="@android:color/white"
            android:contentDescription="Abrir con otra app" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraNavImagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp"
        android:background="@color/visor_barra">

        <TextView
            android:id="@+id/botonImgAnterior"
            style="@style/BotonBarraTexto"
            android:text="◀"
            android:textColor="@android:color/white"
            android:contentDescription="Anterior" />

        <TextView
            android:id="@+id/contadorImg"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/botonImgSiguiente"
            style="@style/BotonBarraTexto"
            android:text="▶"
            android:textColor="@android:color/white"
            android:contentDescription="Siguiente" />
    </LinearLayout>
</FrameLayout>
