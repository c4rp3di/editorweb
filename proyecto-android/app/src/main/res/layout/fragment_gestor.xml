<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <LinearLayout
        android:id="@+id/barraNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/barra_superior"
        android:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/botonSubir"
                style="@style/BotonBarra"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Subir nivel" />

            <TextView
                android:id="@+id/textoRuta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sin_carpeta"
                android:textSize="13sp"
                android:textColor="@color/texto_secundario"
                android:maxLines="2"
                android:ellipsize="middle"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageView
                android:id="@+id/botonFavoritos"
                style="@style/BotonBarra"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Favoritos" />

            <ImageView
                android:id="@+id/botonOrdenar"
                style="@style/BotonBarra"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Ordenar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/texto_secundario"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/entradaBusqueda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Buscar en esta carpeta…"
                android:background="@null"
                android:inputType="text"
                android:textSize="14sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:imeOptions="actionSearch"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/botonBusquedaRecursiva"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="@color/texto_secundario"
                android:contentDescription="Buscar en subcarpetas" />

            <ImageView
                android:id="@+id/botonLimpiarBusqueda"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/texto_secundario"
                android:visibility="gone"
                android:contentDescription="Limpiar búsqueda" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraSeleccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/barra_contextual"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/botonCerrarSeleccion"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@android:color/white"
            android:contentDescription="Cancelar selección" />

        <TextView
            android:id="@+id/textoSeleccionados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />

        <ImageView
            android:id="@+id/botonSelMover"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@android:color/white"
            android:contentDescription="Mover" />

        <ImageView
            android:id="@+id/botonSelCopiar"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_save"
            android:tint="@android:color/white"
            android:contentDescription="Copiar" />

        <ImageView
            android:id="@+id/botonSelCompartir"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_share"
            android:tint="@android:color/white"
            android:contentDescription="Compartir" />

        <ImageView
            android:id="@+id/botonSelBorrar"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@android:color/white"
            android:contentDescription="Borrar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaArchivos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="90dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/estadoVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <TextView
                android:id="@+id/iconoVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📂"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/textoVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/elige_carpeta"
                android:textSize="15sp"
                android:textColor="@color/texto_secundario"
                android:gravity="center"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCarpeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Elegir carpeta"
            app:backgroundTint="@color/primario"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCrear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:layout_marginBottom="88dp"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Crear"
            app:backgroundTint="@color/acento"
            app:tint="@android:color/white"
            app:fabSize="mini" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPegar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:layout_marginBottom="136dp"
            android:src="@android:drawable/ic_menu_add"
            android:contentDescription="Pegar aquí"
            app:backgroundTint="#F39C12"
            app:tint="@android:color/white"
            app:fabSize="mini"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>