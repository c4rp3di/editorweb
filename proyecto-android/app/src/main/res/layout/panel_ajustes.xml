<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F01A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MODO PRO"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAvisoLente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text=""
                android:textColor="#E5C99A"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnDiagnostico"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/boton_circular"
                android:text="🔍"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCerrarAjustes"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/boton_circular"
                android:text="@string/btn_cerrar_ajustes"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- LENTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LENTE"
            android:textColor="#9A9AB0"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnLentePrincipal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1x" android:textSize="12sp" />
            <Button android:id="@+id/btnLenteTele" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="2x" android:textSize="12sp" />
            <Button android:id="@+id/btnLenteUltra" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="0.6x" android:textSize="12sp" />
        </LinearLayout>

        <!-- PRESET MACRO -->
        <Button
            android:id="@+id/btnPresetMacro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#4A3D8A"
            android:text="🎯 Preset MACRO (1x + ~10cm + 2s)"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- TEMPORIZADOR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="TEMPORIZADOR"
            android:textColor="#9A9AB0"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnTimerOff" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Off" android:textSize="12sp" />
            <Button android:id="@+id/btnTimer2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="2s" android:textSize="12sp" />
            <Button android:id="@+id/btnTimer5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="5s" android:textSize="12sp" />
            <Button android:id="@+id/btnTimer10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="10s" android:textSize="12sp" />
        </LinearLayout>

        <!-- ISO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ISO (50–12800)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/valorIso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="400" android:textColor="#7FE0BC" android:textSize="13sp" android:fontFamily="monospace" />
            <Switch android:id="@+id/switchIso" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        </LinearLayout>
        <SeekBar android:id="@+id/sliderIso" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="12750" android:progress="350" />

        <!-- EXPOSICIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Exposición" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/valorExp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1/60s" android:textColor="#7FE0BC" android:textSize="13sp" android:fontFamily="monospace" />
            <Switch android:id="@+id/switchExp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        </LinearLayout>
        <SeekBar android:id="@+id/sliderExp" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" />

        <!-- EXPOSICIÓN LARGA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="EXPOSICIÓN LARGA (bulb simulado)"
            android:textColor="#E5C99A"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <Button android:id="@+id/btnLarga1s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1s" android:textSize="11sp" />
            <Button android:id="@+id/btnLarga2s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:text="2s" android:textSize="11sp" />
            <Button android:id="@+id/btnLarga4s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:text="4s" android:textSize="11sp" />
            <Button android:id="@+id/btnLarga8s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:text="8s" android:textSize="11sp" />
            <Button android:id="@+id/btnLarga15s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:text="15s" android:textSize="11sp" />
            <Button android:id="@+id/btnLarga30s" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:text="30s" android:textSize="11sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnLargaOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="↺ Desactivar exposición larga"
            android:textSize="11sp" />

        <!-- FOCO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Enfoque (mac → ∞)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/valorFoco" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="∞" android:textColor="#7FE0BC" android:textSize="13sp" android:fontFamily="monospace" android:background="#33FFFFFF" android:paddingHorizontal="6dp" android:paddingVertical="2dp" />
            <Switch android:id="@+id/switchFoco" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        </LinearLayout>
        <SeekBar android:id="@+id/sliderFoco" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="0" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca el valor para afinarlo con precisión"
            android:textColor="#8A8AB0"
            android:textSize="10sp" />

        <!-- WB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Temperatura color (K)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/valorWb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5000K" android:textColor="#7FE0BC" android:textSize="13sp" android:fontFamily="monospace" />
            <Switch android:id="@+id/switchWb" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" />
        </LinearLayout>
        <SeekBar android:id="@+id/sliderWb" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="6000" android:progress="3000" />

        <Button
            android:id="@+id/btnResetPro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="↺ Reset valores PRO"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>