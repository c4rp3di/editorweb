<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F01A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="MODO PRO"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAvisoLente"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" android:text="" android:textColor="#E5C99A" android:textSize="10sp" />

            <Button android:id="@+id/btnDiagnostico"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="6dp" android:background="@drawable/boton_circular"
                android:text="🔍" android:textColor="#FFFFFF" android:textSize="16sp" />

            <Button android:id="@+id/btnDebug"
                android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginEnd="6dp" android:background="@drawable/boton_circular"
                android:text="🐞" android:textColor="#FFFFFF" android:textSize="16sp" />

            <Button android:id="@+id/btnCerrarAjustes"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/boton_circular"
                android:text="@string/btn_cerrar_ajustes" android:textColor="#FFFFFF" android:textSize="16sp" />
        </LinearLayout>

        <!-- LENTE -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="LENTE" android:textColor="#9A9AB0" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <Button android:id="@+id/btnLentePrincipal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1x" android:textSize="12sp" />
            <Button android:id="@+id/btnLenteTele" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="2x" android:textSize="12sp" />
            <Button android:id="@+id/btnLenteUltra" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="0.6x" android:textSize="12sp" />
        </LinearLayout>

        <!-- PRESET MACRO -->
        <Button android:id="@+id/btnPresetMacro"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="#4A3D8A"
            android:text="🎯 Preset MACRO (1x + ~10cm + 2s)"
            android:textColor="#FFFFFF" android:textSize="12sp" />

        <!-- TEMPORIZADOR -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="TEMPORIZADOR" android:textColor="#9A9AB0" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <Button android:id="@+id/btnTimerOff" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Off" android:textSize="12sp" />
            <Button android:id="@+id/btnTimer2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="2s" android:textSize="12sp" />
            <Button android:id="@+id/btnTimer5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="5s" android:textSize="12sp" />
            <Button android:id="@+id/btnTimer10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="10s" android:textSize="12sp" />
        </LinearLayout>

        <!-- SWITCHES: los sliders aparecen en la pantalla principal -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="ACTIVAR AJUSTE MANUAL (slider en pantalla)"
            android:textColor="#9A9AB0" android:textSize="11sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="ISO (50–12800)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <Switch android:id="@+id/switchIso" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Exposición (1/8000s–2s)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <Switch android:id="@+id/switchExp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🕐 Exposición larga (1s–30s)" android:textColor="#E5C99A" android:textSize="13sp" />
            <Switch android:id="@+id/switchLarga" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Foco (∞ – 10cm)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <Switch android:id="@+id/switchFoco" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Temperatura color (2000–8000K)" android:textColor="#FFFFFF" android:textSize="13sp" />
            <Switch android:id="@+id/switchWb" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <Button android:id="@+id/btnResetPro"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="↺ Reset valores PRO" android:textSize="12sp" />

    </LinearLayout>
</ScrollView>