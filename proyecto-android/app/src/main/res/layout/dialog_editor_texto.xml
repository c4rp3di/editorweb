<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="@color/barra_superior"
        android:elevation="3dp">

        <ImageView
            android:id="@+id/botonVolver"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cerrar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/nombreEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="archivo.txt"
                android:textSize="14sp"
                android:textColor="@color/texto"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/infoEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/texto_secundario"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/botonDeshacer"
            style="@style/BotonBarraTexto"
            android:text="↶"
            android:contentDescription="Deshacer" />

        <TextView
            android:id="@+id/botonRehacer"
            style="@style/BotonBarraTexto"
            android:text="↷"
            android:contentDescription="Rehacer" />

        <TextView
            android:id="@+id/botonBuscarEditor"
            style="@style/BotonBarraTexto"
            android:text="🔍"
            android:textSize="16sp"
            android:contentDescription="Buscar y reemplazar" />

        <TextView
            android:id="@+id/botonNumeros"
            style="@style/BotonBarraTexto"
            android:text="#"
            android:textStyle="bold"
            android:contentDescription="Números de línea" />

        <ImageView
            android:id="@+id/botonGuardarTexto"
            style="@style/BotonBarra"
            android:src="@android:drawable/ic_menu_save"
            android:contentDescription="Guardar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:background="@color/barra_superior"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/entradaBuscar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Buscar"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/contadorBuscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textSize="12sp"
                android:textColor="@color/texto_secundario" />

            <TextView
                android:id="@+id/botonCaso"
                style="@style/BotonBarraTexto"
                android:layout_width="40dp"
                android:text="Aa"
                android:textSize="14sp"
                android:contentDescription="Distinguir mayúsculas" />

            <TextView
                android:id="@+id/botonAnterior"
                style="@style/BotonBarraTexto"
                android:layout_width="40dp"
                android:text="▲"
                android:textSize="14sp"
                android:contentDescription="Anterior" />

            <TextView
                android:id="@+id/botonSiguiente"
                style="@style/BotonBarraTexto"
                android:layout_width="40dp"
                android:text="▼"
                android:textSize="14sp"
                android:contentDescription="Siguiente" />

            <TextView
                android:id="@+id/botonCerrarBuscar"
                style="@style/BotonBarraTexto"
                android:layout_width="40dp"
                android:text="✕"
                android:textSize="14sp"
                android:contentDescription="Cerrar búsqueda" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/entradaReemplazar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Reemplazar por"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/botonReemplazar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Reemplazar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primario"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/botonReemplazarTodo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Todo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primario"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="400dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/numerosLinea"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="top|end"
                    android:minWidth="36dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/texto_secundario"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/editorTexto"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:background="@color/fondo"
                    android:textColor="@color/texto" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/cargandoEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</LinearLayout>
