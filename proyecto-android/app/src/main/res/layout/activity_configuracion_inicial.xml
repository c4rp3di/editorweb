<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_titulo"
            android:textSize="24sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/texto_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pasos obligatorios: 0/2"
            android:textSize="14sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_1_titulo"
            android:textSize="18sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_1_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_permiso_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_abrir_ajustes"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_2_titulo"
            android:textSize="18sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_2_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_permiso_notificaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_abrir_ajustes"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_3_titulo"
            android:textSize="18sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_3_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_optimizacion_bateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_abrir_ajustes"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_4_titulo"
            android:textSize="18sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_4_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_autostart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_abrir_ajustes"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_5_titulo"
            android:textSize="18sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_5_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_candado_recientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver instrucciones"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_6_titulo"
            android:textSize="18sp"
            android:textColor="#F0EEF8"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_paso_6_desc"
            android:textSize="13sp"
            android:textColor="#B0B0D0"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_acceso_archivos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_abrir_ajustes"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/boton_continuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_finalizar"
            android:enabled="false"
            android:layout_marginBottom="8dp" />
        <Button
            android:id="@+id/boton_omitir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_boton_omitir" />

    </LinearLayout>
</ScrollView>