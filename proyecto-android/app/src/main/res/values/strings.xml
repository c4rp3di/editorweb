    <string name="config_titulo">Configuración inicial</string>
    <string name="config_paso_1_titulo">Permiso de micrófono</string>
    <string name="config_paso_1_desc">Microlisto necesita acceso al micrófono para grabar y transcribir conversaciones.</string>
    <string name="config_paso_2_titulo">Permiso de notificaciones</string>
    <string name="config_paso_2_desc">La grabación en segundo plano requiere una notificación persistente. Sin ella, Android detendrá el servicio.</string>
    <string name="config_paso_3_titulo">Optimización de batería</string>
    <string name="config_paso_3_desc">Excluye Microlisto de la optimización de batería para que HyperOS no mate la grabación en segundo plano.</string>
    <string name="config_paso_4_titulo">Autoinicio en segundo plano</string>
    <string name="config_paso_4_desc">Activa el autoinicio de Microlisto en los ajustes de HyperOS. Sin esto, la app puede cerrarse al salir de la pantalla.</string>
    <string name="config_paso_5_titulo">Candado en recientes</string>
    <string name="config_paso_5_desc">Bloquea Microlisto en la pantalla de apps recientes (desliza hacia arriba y toca el candado). Así HyperOS no la cerrará al liberar memoria.</string>
    <string name="config_paso_6_titulo">Acceso total a archivos</string>
    <string name="config_paso_6_desc">Para guardar grabaciones largas sin restricciones de espacio, Microlisto necesita acceso completo al almacenamiento.</string>
